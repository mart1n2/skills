# =============================================================================
# security-incident-analysis — Environment Variables
# Copy to .env and fill in. Never commit .env.
# Forensics needs an ARCHIVE-CAPABLE RPC (historical --block queries + fork replay).
# Public RPCs are usually pruned and will silently return wrong historical state.
# =============================================================================

# --- Archive RPCs (per chain). Use a dedicated provider (Alchemy/Infura/QuickNode). ---
ETH_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=
AVALANCHE_RPC_URL=
# Keyless archive fallback if your provider throttles: https://eth.drpc.org

# Or override the resolved endpoint directly (wins over per-chain vars):
# RPC_URL=

# Optional Chainlist registry override (used only when no RPC env is configured):
# CHAINLIST_URL=https://chainid.network/chains.json
# CHAINLIST_MAX_CANDIDATES=8
# RPC_PROBE_TIMEOUT=8
# ARCHIVE_PROBE_BLOCK=1000000

# --- Explorer API key (source fetch, ABI, address labels) ---
# Etherscan V2 single key covers all supported chains: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# --- Optional tuning ---
# CHUNK=9000            # eth_getLogs block-window size for reconcile-loss.sh
