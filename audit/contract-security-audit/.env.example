# =============================================================================
# contract-security-audit — Environment Variables
# Copy to .env and fill in your values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Explorer API Keys
# -----------------------------------------------------------------------------

# Etherscan V2 (recommended — single key covers all supported chains)
# Get one at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Chain-specific keys (only needed if NOT using Etherscan V2 above)
OPTIMISM_ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=
POLYGONSCAN_API_KEY=
BSCSCAN_API_KEY=
SNOWSCAN_API_KEY=
GNOSISSCAN_API_KEY=
SCROLLSCAN_API_KEY=
LINEASCAN_API_KEY=
ZKSYNC_API_KEY=
BLASTSCAN_API_KEY=
MANTLESCAN_API_KEY=
MODE_API_KEY=
HYPEREVMSCAN_API_KEY=

# -----------------------------------------------------------------------------
# RPC URLs
# Defaults are public endpoints. Set these for reliability / rate limits.
# -----------------------------------------------------------------------------

ETH_RPC_URL=https://eth.llamarpc.com
OPTIMISM_RPC_URL=https://mainnet.optimism.io
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
GNOSIS_RPC_URL=https://rpc.gnosischain.com
SCROLL_RPC_URL=https://rpc.scroll.io
LINEA_RPC_URL=https://rpc.linea.build
ZKSYNC_RPC_URL=https://mainnet.era.zksync.io
BLAST_RPC_URL=https://rpc.blast.io
MANTLE_RPC_URL=https://rpc.mantle.xyz
MODE_RPC_URL=https://mainnet.mode.network
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm

# -----------------------------------------------------------------------------
# Optional: Source fallback
# -----------------------------------------------------------------------------

# GitHub repo URL to clone when explorer + Sourcify both fail to return source
# GITHUB_URL=https://github.com/org/protocol

# -----------------------------------------------------------------------------
# Optional: Tuning
# -----------------------------------------------------------------------------

# HTTP timeout in seconds for explorer API calls (default: 25)
# EXPLORER_MAX_TIME=25

# curl retry count for explorer API calls (default: 1)
# EXPLORER_RETRY_COUNT=1

# Custom User-Agent header sent with explorer requests
# AUDIT_USER_AGENT=contract-security-audit-skill/1.0
